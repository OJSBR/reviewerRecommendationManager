msgstr "Rəyçi tövsiyələri meneceri"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.description"
msgstr "Rəyçinin rəyi tamamlayarkən seçdiyi tövsiyələri yenidən adlandırın (çoxdilli), sırasını dəyişin və deaktiv edin — OJS nüvəsini dəyişmədən və keçmiş rəylərin tarixçəsini qoruyaraq."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.description"
