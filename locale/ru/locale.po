msgstr "Отображаемая подпись"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.dragHint"
msgstr "Перетаскивайте элементы за маркер ⠿, чтобы задать порядок их появления в форме рецензирования."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.enabled"
msgstr "Доступно в форме рецензирования"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.usageWarning"
msgstr "Этот вариант уже используется в {$usage} рецензиях — переименование изменит их отображение."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.usageSafe"
msgstr "Этот вариант не используется ни в одной рецензии — его можно безопасно переопределить."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.disableNote"
msgstr "Отключение убирает вариант только из формы рецензирования. Редакторы по-прежнему видят эту рекомендацию в прошлых рецензиях, где она использовалась."
