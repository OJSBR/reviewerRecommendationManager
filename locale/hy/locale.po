#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.displayName"
msgstr "Գրախոսների հանձնարարականների կառավարիչ"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.description"
msgstr "Վերանվանել (բազմալեզու), վերադասավորել և անջատել այն հանձնարարականները, որոնք գրախոսն ընտրում է գրախոսությունն ավարտելիս՝ առանց OJS-ի միջուկը փոխելու և պահպանելով նախորդ գրախոսությունների պատմությունը։"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.description"
msgstr "Կարգավորեք գրախոսներին ցուցադրվող հանձնարարականների ցանկը։ Փոփոխությունները վերաբերում են այս ամսագրին և մնում են բազմալեզու։ Թողեք պիտակը դատարկ որևէ լեզվում՝ OJS-ի կանխադրված տեքստը պահելու համար։"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.title"
msgstr "Զգուշություն պիտակները վերանվանելիս"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.body"
msgstr "Պիտակի վերանվանումը հետադարձ ուժ ունի. արդեն ներկայացված գրախոսությունները ամբողջ հարթակում կցուցադրվեն նոր տեքստով (գրախոս, խմբագիր, հեղինակ, նամակներ և API)։ Եթե փոփոխությունը փոխում է պատասխանի ԻՄԱՍՏԸ, ավելի լավ է անջատել հին տարբերակը և նոր իմաստի համար օգտագործել 0 գրախոսություն ունեցող տարբերակը՝ դա թույլ չի տա խեղաթյուրել գրառումը։"

