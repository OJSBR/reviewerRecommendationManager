msgid "plugins.generic.reviewerRecommendationManager.displayName"
msgstr "Gestor de Recomendações do Revisor"

msgid "plugins.generic.reviewerRecommendationManager.description"
msgstr "Permite renomear (multilingue), reordenar e desativar as recomendações que o revisor escolhe ao concluir a revisão, sem alterar o núcleo do OJS e preservando o histórico das revisões já realizadas."

msgid "plugins.generic.reviewerRecommendationManager.settings.description"
msgstr "Configure a lista de recomendações apresentada ao revisor. As alterações aplicam-se a esta revista e continuam multilingues. Deixe o rótulo em branco num idioma para manter o texto padrão do OJS."

msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.title"
msgstr "Atenção ao alterar rótulos"

msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.body"
msgstr "Renomear um rótulo é retroativo: os pareceres já emitidos passam a ser apresentados com o novo texto em toda a plataforma (revisor, editor, autor, e-mails e API). Se a alteração muda o SENTIDO da resposta, prefira desativar a opção antiga e reaproveitar uma opção com 0 pareceres para o novo significado — assim o histórico não é falsificado."

msgid "plugins.generic.reviewerRecommendationManager.settings.originalLabel"
msgstr "Recomendação original do OJS"

msgid "plugins.generic.reviewerRecommendationManager.settings.customLabel"
msgstr "Rótulo apresentado"

msgid "plugins.generic.reviewerRecommendationManager.settings.dragHint"
msgstr "Arraste os itens pelo ícone ⠿ para definir a ordem em que aparecem no formulário do revisor."

msgid "plugins.generic.reviewerRecommendationManager.settings.enabled"
msgstr "Disponível no formulário do revisor"

msgid "plugins.generic.reviewerRecommendationManager.settings.usageWarning"
msgstr "{$usage} parecer(es) já utilizam esta opção — renomear altera a forma como são apresentados."

msgid "plugins.generic.reviewerRecommendationManager.settings.usageSafe"
msgstr "0 pareceres utilizam esta opção — seguro redefinir."

msgid "plugins.generic.reviewerRecommendationManager.settings.disableNote"
msgstr "Desativar remove a opção apenas do formulário do revisor. O editor continua a ver essa recomendação nos pareceres antigos que a utilizaram."
