#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.displayName"
msgstr "Upravitelj priporočil recenzentov"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.description"
msgstr "Preimenovanje (večjezično), prerazporeditev in onemogočanje priporočil, ki jih recenzent izbere ob zaključku recenzije – brez spreminjanja jedra OJS in z ohranjeno zgodovino prejšnjih recenzij."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.description"
msgstr "Nastavite seznam priporočil, ki se prikaže recenzentom. Spremembe veljajo za to revijo in ostanejo večjezične. Če želite ohraniti privzeto besedilo OJS, pustite oznako v posameznem jeziku prazno."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.title"
msgstr "Previdno pri preimenovanju oznak"

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.historyNotice.body"
msgstr "Preimenovanje oznake velja za nazaj: že oddane recenzije bodo po vsej platformi prikazane z novim besedilom (recenzent, urednik, avtor, e-pošta in API). Če sprememba spremeni POMEN odgovora, raje onemogočite staro možnost in za nov pomen uporabite možnost z 0 recenzijami – tako zapisa ne popačite."

#, fuzzy
msgid "plugins.generic.reviewerRecommendationManager.settings.originalLabel"
